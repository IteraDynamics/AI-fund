# Copy this file to .env and fill in your values
# The system reads these via os.getenv()

# LLM provider: anthropic | ollama | grok
LLM_PROVIDER=ollama

# Anthropic key required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Ollama (local/free) settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Grok/xAI settings (required only when LLM_PROVIDER=grok)
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini

# Optional — used for news sentiment (Alpha Vantage free tier is fine)
ALPHA_VANTAGE_API_KEY=

# Optional — controls log verbosity: DEBUG | INFO | WARNING
LOG_LEVEL=INFO
